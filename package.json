    "exceljs": "^4.4.0",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
