# Names only. Never commit real values. Copy to .env.local for development.
# --- Core (required for launch) ---
DATABASE_URL=                 # PostgreSQL (Neon / Vercel Postgres / Supabase). Leave empty locally to use the embedded database in .data/
AUTH_SECRET=                  # 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_URL=http://localhost:3000 # public base URL, used in e-mails and payment callbacks
SUPERADMIN_EMAIL=folahandaniel@gmail.com
# --- Email (required for password reset / receipts in production) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=            # must be on a domain verified in Resend
# --- Payments (required before charging anyone) ---
PAYSTACK_SECRET_KEY=          # sk_test_... / sk_live_...
PAYSTACK_PUBLIC_KEY=
# --- Optional ---
BLOB_READ_WRITE_TOKEN=        # object storage (Vercel Blob) for large media; without it files are stored in the database
IMAGE_PROVIDER_API_KEY=       # optional image search / generation provider
VIDEO_PROVIDER_API_KEY=       # optional AI video provider (Veo / Runway) - feature stays off without it
SPEECH_PROVIDER_API_KEY=      # optional premium narration provider
SENTRY_DSN=                   # optional error monitoring
CRON_SECRET=                  # protects /api/cron/maintenance
